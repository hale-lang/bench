// Cross-process SHM delivery, LARGE payload (~4 KB) — Hale PRODUCER.
//
// IMPORTANT layout note: Hale lays out a fixed-size ARRAY field
// (`[Int; N]`) as an out-of-line arena POINTER inside the struct, so
// an array-field payload is only 16 bytes in the shm slot and its
// pointer DANGLES cross-process (segfaults the reader). See the
// xproc README "large-payload" finding. To get a genuinely FLAT ~4 KB
// inline payload that survives cross-process zero-copy, this uses a
// struct of 512 scalar Int fields (= 4096 bytes), which
// codegen inlines into the slot. Known pattern: f<k> = i + k, so the
// reader can checksum.
//
// N dropped to 20000 (vs the 16-byte variant's 200000) so the no-wrap
// ring (slot_count >= N, ~4 KB/slot) stays ~80 MB.
type Blob {
    f0: Int = 0;
    f1: Int = 0;
    f2: Int = 0;
    f3: Int = 0;
    f4: Int = 0;
    f5: Int = 0;
    f6: Int = 0;
    f7: Int = 0;
    f8: Int = 0;
    f9: Int = 0;
    f10: Int = 0;
    f11: Int = 0;
    f12: Int = 0;
