        if self.seen == self.n {
            let elapsed = std::time::monotonic_ns() - self.t0;
            print("iters="); println(self.n);
            print("elapsed_ns="); println(elapsed);
            print("checksum="); println(self.checksum);
            std::process::exit(0);
        }
    }
}

main locus App {
    bindings {
        Frame: shm_ring("/bench-shm-xproc-large", slot_count: 20480, on_overflow: drop) where zero_copy;
    }
}

fn main() {
    App { };
    Sub { };
    time::sleep(30s);
}
