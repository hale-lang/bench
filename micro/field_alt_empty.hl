// field_alt_empty — a String self field alternating between a heap
// value and the empty literal: the shape of a protocol framer's
// current-frame fields (a message, then a control frame's empties).
// Each write retires the old block and the next reuses it.
//
// hale-lang/hale#1033: before the fix the empty write shrank the block
// in place, the next write retired it under its shrunk size, and a
// block leaked per cycle — ~1040 ms and 36 MB here, against ~48 ms and
// flat after.

locus H {
    params { s: String = ""; n: Int = 0; }
    fn a() { self.s = std::str::upper("hello"); self.n = self.n + 1; }
    fn b() { self.s = ""; self.n = self.n + 1; }
}

fn main() {
    let h = H { };
    let iters = 1000000;
    let t0 = std::time::monotonic();
    let mut i = 0;
    while i < iters { h.a(); h.b(); i = i + 1; }
    let t1 = std::time::monotonic();
    print("n="); println(h.n);
    print("elapsed_ns="); println(t1 - t0);
}
