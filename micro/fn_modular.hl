// fn_modular — modular "helper calls helper" overhead.
//
// `outer(x, g)` calls the helper through `g` and does arithmetic on
// the result — the shape of clean, factored code where small
// functions compose. Called 10M times. This is the bench for "is
// factoring a hot path into small helpers free?"
//
// Both hops go through OPAQUE function pointers (pid-parity
// selected at startup — see fn_call.hl's note): Hale has no
// noinline surface, and after the 2026-07-02 exit-drain elision the
// direct-call version inlines + folds to nothing. The inner pointer
// is passed as a PARAM so it's selected once, not per call —
// deviation from the .go's direct noinline call, same real
// two-deep call chain.
//
// History: 2026-06-28 interprocedural non-allocating propagation
// elided the caller-side scratch (~21 ns → ~4 ns); 2026-07-02
// exit-drain elision removed the per-call bus drain from both
// frames.
fn inner(x: Int) -> Int {
    return x + 1;
}

fn inner_odd(x: Int) -> Int {
    return x + 2;
}

fn outer(x: Int, g: fn(Int) -> Int) -> Int {
    return g(x) * 3;
}

fn outer_odd(x: Int, g: fn(Int) -> Int) -> Int {
    return g(x) * 5;
}

fn main() {
    let iters = 10000000;
    let pid = std::process::pid();
    let f: fn(Int, fn(Int) -> Int) -> Int =
        if pid % 2 == 0 { outer } else { outer_odd };
    let g: fn(Int) -> Int = if pid % 2 == 0 { inner } else { inner_odd };
    let t0 = std::time::monotonic();
    let mut i = 0;
    let mut acc = 0;
    while i < iters {
        acc = f(i, g);
        i = i + 1;
    }
    let t1 = std::time::monotonic();
    print("iters="); println(iters);
    print("acc="); println(acc);
    print("elapsed_ns="); println(t1 - t0);
}
