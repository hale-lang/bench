// form_vec_get — @form(vec) indexed read.
//
// FORM-3 microbench target. Populate 1M elements once (outside
// timing), then 1M `get(i) or raise` calls, XOR-folded so the read
// the bounds-check + load + fallible-unwrap path.

@form(vec)
locus IntVec {
    capacity { heap items of Int; }
}

fn main() {
    // 200k — MATCHED across all language variants (.go/.js/.py)
    // so the comparison is apples-to-apples. (Was 5M here only,
    // 25× the other langs, which made the cross-language ratio a
    // workload mismatch, not a perf measurement.) At 200k the
    // working set (~1.6MB) is L2/L3-resident, so this measures the
    // per-element read path — where the bounds-check elimination
    // win shows — not raw DRAM bandwidth.
    let iters = 200000;
    let v = IntVec { };

    // Populate (outside timing).
    let mut i = 0;
    while i < iters {
        v.push(i);
        i = i + 1;
    }

    // Canonical counted-loop form: `for j in 0..v.len()` over an
    // unmutated local vec instance. The compiler's bounds-check
    // elimination proves `j < len(v)` by construction, drops the
    // per-element check, and lets the read+XOR body vectorize.
    // `iters == v.len()` here, so the work is identical to the prior
    // `while j < iters` shape.
    let t0 = std::time::monotonic();
    let mut acc = 0;
    for j in 0..v.len() {
        acc = acc ^ (v.get(j) or raise);
    }
    let t1 = std::time::monotonic();
    print("iters=");
    println(iters);
    print("acc=");
    println(acc);
    print("elapsed_ns=");
    println(t1 - t0);
}
