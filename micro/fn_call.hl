// fn_call — free-fn call overhead with a minimal real body.
//
// `step(x)` does one small arithmetic transform — the shape of a
// helper you'd actually factor out — called 10M times in a tight
// loop to isolate per-call overhead.
//
// History: before the 2026-06-28 allocation-classification work a
// free fn whose body did ANY `+` (or called another fn) was treated
// as possibly-allocating and paid a per-call scratch-arena
// malloc/free — this body cost ~10 ns/call. The type-aware `Add`
// classification recognizes `Int + Int` as arithmetic, so the
// scratch is elided and the call runs at ~2 ns. (The earlier
// `return x;` body measured nothing: a bare identifier was always
// elided, and the "every free fn opens a subregion" note was stale.)
fn step(x: Int) -> Int {
    return x * 2 + 1;
}

fn main() {
    let iters = 10000000;
    let t0 = std::time::monotonic();
    let mut i = 0;
    let mut acc = 0;
    while i < iters {
        acc = step(i);
        i = i + 1;
    }
    let t1 = std::time::monotonic();
    print("iters="); println(iters);
    print("acc="); println(acc);
    print("elapsed_ns="); println(t1 - t0);
}
