// fn_call — free-fn call overhead with a minimal real body.
//
// `step(x)` does one small arithmetic transform — the shape of a
// helper you'd actually factor out — called 10M times in a tight
// loop to isolate per-call overhead.
//
// The call goes through an OPAQUE function pointer (selected by
// pid parity at startup between two same-shape fns) so the call is
// real: the .go/.c/.rs siblings force a real call with noinline
// attributes, and Hale has no noinline surface — after the
// 2026-07-02 exit-drain elision made `step` a two-instruction pure
// fn, LLVM inlined it and folded the whole loop. A compile-time-
// unknown target pins a real call boundary; at run time the target
// is loop-invariant, so the CPU predicts it perfectly — cost
// parity with the comparators' direct noinline calls.
//
// History: 2026-06-28 allocation classification elided the
// per-call scratch (~10 ns → ~2 ns); 2026-07-02 exit-drain elision
// removed the remaining per-call `lotus_bus_queue_drain` (a
// non-allocating body can't have published; fn exit is not a
// spec-required yield point), taking the callee to C shape:
// `lea; ret`.
fn step(x: Int) -> Int {
    return x * 2 + 1;
}

fn step_odd(x: Int) -> Int {
    return x * 2 + 3;
}

fn main() {
    let iters = 10000000;
    let pid = std::process::pid();
    let f: fn(Int) -> Int = if pid % 2 == 0 { step } else { step_odd };
    let t0 = std::time::monotonic();
    let mut i = 0;
    let mut acc = 0;
    while i < iters {
        acc = f(i);
        i = i + 1;
    }
    let t1 = std::time::monotonic();
    print("iters="); println(iters);
    print("acc="); println(acc);
    print("elapsed_ns="); println(t1 - t0);
}
