// loop_overhead — tight loop with non-elidable integer work.
//
// Originally a pure empty while loop, but the post-wrap codegen
// is aggressive enough to symbolically prove the loop's final
// state and constant-fold the entire loop away (the compiler
// even handles iters = 100M + pid() correctly via cmovg).
//
// To keep the bench measuring something, the loop body XORs the
// counter into a pid-seeded accumulator that's printed (escapes,
// so it can't be folded to a constant).
//
// What it measures now (2026-06-28): with the native-CPU + O3
// codegen defaults, LLVM AUTOVECTORIZES this XOR reduction to
// AVX-512 — 100M iters in ~1.6 ms (~0.016 ns/iter, far below one
// scalar cycle/iter). So this is no longer "scalar loop overhead"
// but vectorized-reduction throughput, and the large cross-language
// ratio (~12× vs Go, ~13× vs Node) reflects that Hale's backend
// vectorizes this loop while Go's / V8's do not — a real
// autovectorization win on reducible loops, not a loop-construct
// measurement. (A future variant could add a loop-carried
// dependence to force scalar execution if pure overhead is wanted.)

fn main() {
    let iters = 100000000 + std::process::pid();
    let t0 = std::time::monotonic();
    let mut i = 0;
    let mut acc = std::process::pid();
    while i < iters {
        acc = acc ^ i;
        i = i + 1;
    }
    let t1 = std::time::monotonic();
    print("iters=");
    println(iters);
    print("acc=");
    println(acc);
    print("elapsed_ns=");
    println(t1 - t0);
}
