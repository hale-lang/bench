# Per-run JSON reports.
results/

# Compiled bench binaries land next to their .hl source. Source
# files for each language stay tracked (.hl, .go, .js, .py); the
# compiled binary that lands next to them does not.
micro/*
!micro/*.hl
!micro/*.go
!micro/*.js
!micro/*.py
app/*
!app/*.hl
!app/*.go
!app/*.js
!app/*.py
c-twins/*
!c-twins/*.c

# xproc/ (cross-process SHM delivery bench). Keep the language
# sources + scripts tracked; ignore compiled artifacts: the Hale
# reader/producer binaries (extensionless, named after their .hl)
# and the Go binary.
xproc/shm_xproc_reader
xproc/shm_xproc_reader_drain
xproc/shm_xproc_producer
xproc/shm_xproc_large_reader
xproc/shm_xproc_large_reader_drain
xproc/shm_xproc_large_producer
xproc/*.bin
xproc/*.go.bin

# OS / editor
.DS_Store
.vscode/
.idea/
*.swp
*~
